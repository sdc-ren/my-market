# ==============================================================================
# SUPABASE POSTGRESQL DATABASE URL (DÀNH CHO BACKEND & DRIZZLE ORM)
# ==============================================================================
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI

# 1. DATABASE_URL: Cổng 6543 (Transaction Pooler - Supavisor)
# Backend Express & Drizzle ORM dùng URL này để kết nối cơ sở dữ liệu:
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 2. DIRECT_URL: Cổng 5432 (Session Mode / Direct Connection)
# Dùng cho các lệnh DDL migration và đẩy bảng tự động (npm run db:push):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# PORT & APP CONFIG
# ==============================================================================
PORT=3000
NODE_ENV=development

# 3. SESSION_SECRET: khóa ký session đăng nhập quản lý (PIN).
# BẮT BUỘC đặt trên Vercel (Project Settings -> Environment Variables),
# nếu không session sẽ mất mỗi lần deploy. Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=doi-thanh-chuoi-ngau-nhien-64-ky-tu
